@page "/app/settings/overlay"
@layout SettingsLayout
@using RatScanner
@using RatScanner.Components
@inject SettingsVM SettingsVM
@inject LocalizationService Localizer
@implements IDisposable

<div class="settings-stack">
    <SettingsCard Title="@Localizer["ScanningOverlayGroup"]" Subtitle="@Localizer["ScanningOverlayGroupDesc"]">
        <SettingsRow Label="@Localizer["EnableScanningOverlay"]" SubLabel="@Localizer["EnableScanningOverlayHint"]">
            <MudSwitch T="bool" Checked="@SettingsVM.EnableScanningOverlay"
                       CheckedChanged="@((bool v) => { SettingsVM.EnableScanningOverlay = v; SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>
    </SettingsCard>

    <SettingsCard Title="@Localizer["FloatingTooltipGroup"]" Subtitle="@Localizer["FloatingTooltipGroupDesc"]">
        <SettingsRow Label="@Localizer["EnableFloatingTooltip"]" SubLabel="@Localizer["EnableFloatingTooltipHint"]">
            <MudSwitch T="bool" Checked="@SettingsVM.IsFloatingTooltipEnabled"
                       CheckedChanged="@((bool v) => { SettingsVM.IsFloatingTooltipEnabled = v; SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>
        @TooltipRow("NameLabel", SettingsVM.IsFloatingTooltipShowName, v => SettingsVM.IsFloatingTooltipShowName = v)
        @TooltipRow("AvgDailyPrice", SettingsVM.IsFloatingTooltipShowAvgDayPrice, v => SettingsVM.IsFloatingTooltipShowAvgDayPrice = v)
        @TooltipRow("PricePerSlot", SettingsVM.IsFloatingTooltipShowPricePerSlot, v => SettingsVM.IsFloatingTooltipShowPricePerSlot = v)
        @TooltipRow("TraderPrice", SettingsVM.IsFloatingTooltipShowTraderPrice, v => SettingsVM.IsFloatingTooltipShowTraderPrice = v)
        @TooltipRow("ShowTasks", SettingsVM.IsFloatingTooltipShowTasksInfo, v => SettingsVM.IsFloatingTooltipShowTasksInfo = v)
        @TooltipRow("ShowHideoutUpgrades", SettingsVM.IsFloatingTooltipShowHideoutInfo, v => SettingsVM.IsFloatingTooltipShowHideoutInfo = v)
        @TooltipRow("ShowBarters", SettingsVM.IsFloatingTooltipShowBarterInfo, v => SettingsVM.IsFloatingTooltipShowBarterInfo = v)
        @TooltipRow("ShowCrafts", SettingsVM.IsFloatingTooltipShowCraftsInfo, v => SettingsVM.IsFloatingTooltipShowCraftsInfo = v)
        @TooltipRow("UpdatedTimestamp", SettingsVM.IsFloatingTooltipShowUpdated, v => SettingsVM.IsFloatingTooltipShowUpdated = v)
        @TooltipRow("OverlayPrice", SettingsVM.IsFloatingTooltipShowOverlayPrice, v => SettingsVM.IsFloatingTooltipShowOverlayPrice = v)
        @TooltipRow("OverlayTaskBadge", SettingsVM.IsFloatingTooltipShowOverlayTaskBadge, v => SettingsVM.IsFloatingTooltipShowOverlayTaskBadge = v)
        @TooltipRow("OverlayHideoutBadge", SettingsVM.IsFloatingTooltipShowOverlayHideoutBadge, v => SettingsVM.IsFloatingTooltipShowOverlayHideoutBadge = v)
    </SettingsCard>
    
    <SettingsCard Title="@Localizer["OverlayGroup"]" Subtitle="@Localizer["OverlayGroupDesc"]">
        <SettingsRow Label="@Localizer["EnableSearchOverlay"]" SubLabel="@Localizer["EnableSearchOverlayHint"]">
            <MudSwitch T="bool" Checked="@SettingsVM.EnableIneractableOverlay"
                       CheckedChanged="@((bool v) => { SettingsVM.EnableIneractableOverlay = v; SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["BlurBehindSearch"]" SubLabel="@Localizer["BlurBehindSearchHint"]"
                     Disabled="@(!SettingsVM.EnableIneractableOverlay)">
            <MudSwitch T="bool" Checked="@SettingsVM.BlurBehindSearch"
                       CheckedChanged="@((bool v) => { SettingsVM.BlurBehindSearch = v; SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>
    </SettingsCard>

    <SettingsCard Title="@Localizer["OverlayHotkeysGroup"]" Subtitle="@Localizer["OverlayHotkeysGroupDesc"]">
        <SettingsRow Label="@Localizer["OpenSearchOverlay"]" SubLabel="@Localizer["OpenSearchOverlayHint"]"
                     Disabled="@(!SettingsVM.EnableIneractableOverlay)">
            <HotkeySelector Hotkey="@SettingsVM.InteractableOverlayHotkey" @key="SettingsVM.InteractableOverlayHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["OpenMapViewer"]" SubLabel="@Localizer["OpenMapViewerHint"]"
                     Disabled="@(!SettingsVM.EnableIneractableOverlay)">
            <HotkeySelector Hotkey="@SettingsVM.OpenMapHotkey" @key="SettingsVM.OpenMapHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>
    </SettingsCard>
</div>

@code {
    protected override void OnInitialized() {
        SettingsVM.PropertyChanged += PropertyChangeHandler;
    }

    private void PropertyChangeHandler(object? sender, System.ComponentModel.PropertyChangedEventArgs e) {
        _ = InvokeAsync(() => StateHasChanged());
    }

    public void Dispose() {
        SettingsVM.PropertyChanged -= PropertyChangeHandler;
    }

    private RenderFragment TooltipRow(string labelKey, bool value, Action<bool> set) =>
        @<SettingsRow Label="@Localizer[labelKey]" Disabled="@(!SettingsVM.IsFloatingTooltipEnabled)">
            <MudSwitch T="bool" Checked="@value"
                       CheckedChanged="@((bool v) => { set(v); SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>;
}
